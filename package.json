{
  "name": "kafka-manager",
  "displayName": "Kafka Manager",
  "description": "Manage Apache Kafka clusters from VS Code: browse topics and partitions, inspect consumer groups and lag, produce/tail messages, and explain problems with AI (Claude, GPT, Gemini, Ollama or Copilot).",
  "publisher": "PatrickPhan",
  "version": "0.4.0",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phankieuphu/vscode-kafka.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Clusters defined in workspace settings are ignored until you trust the workspace, since they can point the extension at arbitrary brokers and certificate files.",
      "restrictedConfigurations": [
        "kafka.clusters"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "Kafka Manager",
      "properties": {
        "kafka.clusters": {
          "type": "array",
          "default": [],
          "description": "Configured Kafka clusters. Managed via the 'Kafka: Add Cluster' command; edit by hand if you need to. Clusters can live in user settings or, to share them with a team, in workspace settings (.vscode/settings.json). Passwords are never stored here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "brokers"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "brokers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ssl": {
                "description": "TLS to the brokers. `true` verifies against the system CAs; use an object for a private CA or to skip verification.",
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "caFile": {
                        "type": "string",
                        "description": "Path to a PEM file with the CA that signed the broker certificates."
                      },
                      "rejectUnauthorized": {
                        "type": "boolean",
                        "default": true,
                        "description": "Set to false to accept self-signed certificates (dev clusters only)."
                      },
                      "certFile": {
                        "type": "string",
                        "description": "Path to a PEM client certificate for mutual TLS (e.g. Aiven). Requires keyFile."
                      },
                      "keyFile": {
                        "type": "string",
                        "description": "Path to the PEM private key for certFile (unencrypted)."
                      }
                    }
                  }
                ]
              },
              "sasl": {
                "type": "object",
                "description": "SASL authentication. Passwords are kept in VS Code's secret storage, never in settings; you'll be asked for one on connect if none is saved.",
                "required": [
                  "mechanism"
                ],
                "additionalProperties": false,
                "properties": {
                  "mechanism": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "scram-sha-256",
                      "scram-sha-512",
                      "aws-iam"
                    ],
                    "enumDescriptions": [
                      "SASL/PLAIN (e.g. Confluent Cloud API keys)",
                      "SASL/SCRAM-SHA-256",
                      "SASL/SCRAM-SHA-512 (Amazon MSK)",
                      "Amazon MSK IAM, signed with your AWS credentials (TLS is always used)"
                    ]
                  },
                  "username": {
                    "type": "string",
                    "description": "For plain/scram mechanisms."
                  },
                  "region": {
                    "type": "string",
                    "description": "For aws-iam: the MSK cluster's AWS region."
                  },
                  "profile": {
                    "type": "string",
                    "description": "For aws-iam: AWS profile to use; the default credential chain when omitted."
                  }
                }
              },
              "schemaRegistry": {
                "type": "object",
                "description": "Confluent-compatible Schema Registry used to decode Avro, Protobuf and JSON Schema messages. The password is kept in VS Code's secret storage.",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "e.g. http://localhost:8081"
                  },
                  "username": {
                    "type": "string",
                    "description": "Basic-auth user; for Confluent Cloud, the Schema Registry API key."
                  }
                }
              }
            }
          }
        },
        "kafka.lagAlerts": {
          "type": "array",
          "default": [],
          "markdownDescription": "Consumer groups to watch. While the cluster is connected, a warning appears when a group's total lag goes above `threshold` messages. Use **Watch Lag…** on a consumer group to add one.",
          "items": {
            "type": "object",
            "required": [
              "cluster",
              "group",
              "threshold"
            ],
            "additionalProperties": false,
            "properties": {
              "cluster": {
                "type": "string",
                "description": "Cluster id or name."
              },
              "group": {
                "type": "string",
                "description": "Consumer group id."
              },
              "threshold": {
                "type": "integer",
                "minimum": 0,
                "description": "Alert when total lag is above this many messages."
              }
            }
          }
        },
        "kafka.lagAlertIntervalSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "description": "How often watched consumer groups' lag is checked, in seconds."
        },
        "kafka.devMode.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Dev mode**: automatically scan connected clusters for common Kafka issues (offline or under-replicated partitions, consumers stopped with lag, offsets lost to retention or past a recreated topic's end, stuck rebalances, growing lag, dead-letter traffic, typo'd topic names). New problems are logged to the Kafka Manager output, notified, and counted in the status bar. Toggle with **Kafka: Toggle Dev Mode**."
        },
        "kafka.devMode.scanIntervalSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "description": "How often dev mode scans connected clusters, in seconds."
        },
        "kafka.devMode.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when dev mode finds a new warning or critical issue. Issues are still logged and counted when off."
        },
        "kafka.devMode.ignoredRules": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "description": "Dev mode checks to skip.",
          "items": {
            "type": "string",
            "enum": [
              "noController",
              "offlinePartitions",
              "underReplicated",
              "offsetBehindRetention",
              "offsetBeyondLogEnd",
              "orphanedOffsets",
              "lagWithoutMembers",
              "stuckRebalance",
              "growingLag",
              "deadLetterTraffic",
              "similarTopicNames"
            ],
            "enumDescriptions": [
              "No active controller",
              "Partitions without a leader",
              "Under-replicated partitions",
              "Committed offsets already deleted by retention",
              "Committed offsets past the end of the log (topic recreated)",
              "Offsets left for deleted topics",
              "Lag on a group with no running consumers",
              "Group stuck rebalancing across scans",
              "Lag growing scan after scan while consumers run",
              "Messages in dead-letter topics (.dlq, -dlt, DLT…)",
              "Near-identical topic names (likely typos)"
            ]
          }
        },
        "kafka.ai.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable AI features: the Kafka AI chat, `@kafka` in the Chat view, Explain buttons, lag analysis and `#kafka_*` tools. Always off in untrusted workspaces. Run **Kafka: AI Setup…** to choose a provider and see what is sent."
        },
        "kafka.ai.provider": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "enum": [
            "auto",
            "anthropic",
            "openai",
            "gemini",
            "openrouter",
            "vscode",
            "azureOpenai",
            "mistral",
            "xai",
            "deepseek",
            "groq",
            "ollama",
            "lmstudio",
            "custom"
          ],
          "enumItemLabels": [
            "Auto",
            "Anthropic Claude",
            "OpenAI GPT",
            "Google Gemini",
            "OpenRouter",
            "VS Code language models",
            "Azure OpenAI",
            "Mistral AI",
            "xAI Grok",
            "DeepSeek",
            "Groq",
            "Ollama (local)",
            "LM Studio (local)",
            "Custom OpenAI-compatible endpoint"
          ],
          "markdownEnumDescriptions": [
            "The first provider with an API key (Claude, GPT, Gemini, OpenRouter…), else VS Code's chat models.",
            "Claude models with an Anthropic API key",
            "GPT models with an OpenAI API key",
            "Gemini models with a Google AI Studio API key (free tier available)",
            "Sign in with your browser: Claude, GPT, Gemini, Llama, Mistral and more with one account",
            "GitHub Copilot or any chat model extension, signed in through VS Code",
            "Your Azure OpenAI or Azure AI Foundry deployment (OpenAI v1 API)",
            "Mistral models with a Mistral API key",
            "Grok models with an xAI API key",
            "DeepSeek models with a DeepSeek API key",
            "Fast open models (Llama, Qwen, GPT-OSS…) with a Groq API key",
            "Models running on this machine with Ollama; nothing leaves your computer",
            "Models served by LM Studio on this machine; nothing leaves your computer",
            "LiteLLM, vLLM, a company gateway or any server with the OpenAI Chat Completions API"
          ],
          "markdownDescription": "Where AI requests go. API keys are kept in VS Code's secret storage (your OS keychain), never in settings; set them with **Kafka: Set AI API Key…** or **Kafka: AI Setup…**. User settings only."
        },
        "kafka.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model id for the provider, e.g. `claude-sonnet-5-5`, `gpt-5.5`, `gemini-flash-latest`, `llama3.2` (Ollama) or a VS Code model family. Leave empty for the provider's recommended model. **Kafka: Select AI Model…** lists what your key can use."
        },
        "kafka.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Endpoint override for the provider: required for Azure OpenAI (`https://<resource>.openai.azure.com/openai/v1`) and custom OpenAI-compatible servers; optional otherwise (proxies, Ollama on another host). Must be `https://`, or `http://` to localhost. User settings only, so a workspace can't redirect your API key."
        },
        "kafka.ai.maxOutputTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 256,
          "maximum": 32000,
          "markdownDescription": "Longest answer, in tokens, requested from API-key providers."
        },
        "kafka.ai.includeMessagePayloads": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Send message keys, headers and values (truncated, credentials stripped) to the model, for **Explain message**, **Infer schema** and the `kafka_peekMessages` tool. Off by default: only metadata such as topic names, offsets and configs is sent."
        },
        "kafka.ai.maskHosts": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Replace broker and Schema Registry hostnames with placeholders (`host-1`, `host-2`…) before sending context to the model."
        },
        "kafka.ai.chatLocation": {
          "type": "string",
          "default": "panel",
          "enum": [
            "panel",
            "chatView"
          ],
          "markdownEnumDescriptions": [
            "The Kafka AI panel inside Kafka Manager. Works with every provider.",
            "VS Code's Chat view (`@kafka`). Needs a chat extension such as GitHub Copilot to show the Chat view."
          ],
          "markdownDescription": "Where **Ask AI** opens. Explain buttons that send messages or lag readings always use the Kafka AI panel."
        },
        "kafka.ai.autoAnalyzeLagAlerts": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When a lag alert fires, ask the model for a one-line likely cause and add it to the notification. Only runs after you've accepted the data notice for the current provider."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kafkaExplorerContainer",
          "title": "Kafka",
          "icon": "resources/kafka.svg"
        }
      ]
    },
    "views": {
      "kafkaExplorerContainer": [
        {
          "id": "kafkaExplorer",
          "name": "Clusters"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kafka-manager.addCluster",
          "when": "view == kafkaExplorer",
          "group": "navigation@1"
        },
        {
          "command": "kafka-manager.refresh",
          "when": "view == kafkaExplorer",
          "group": "navigation@2"
        },
        {
          "command": "kafka-manager.askAi",
          "when": "view == kafkaExplorer && kafka-manager.aiEnabled",
          "group": "navigation@3"
        },
        {
          "command": "kafka-manager.toggleDevMode",
          "when": "view == kafkaExplorer",
          "group": "8_devMode@1"
        },
        {
          "command": "kafka-manager.showDetectedIssues",
          "when": "view == kafkaExplorer && kafka-manager.devMode",
          "group": "8_devMode@2"
        },
        {
          "command": "kafka-manager.aiSetup",
          "when": "view == kafkaExplorer",
          "group": "9_ai@1"
        }
      ],
      "view/item/context": [
        {
          "command": "kafka-manager.openDashboard",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "inline@0"
        },
        {
          "command": "kafka-manager.openDashboard",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "0_connection@0"
        },
        {
          "command": "kafka-manager.removeCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "3_remove"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopicsFolder",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.viewTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.produceMessage",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "inline@2"
        },
        {
          "command": "kafka-manager.deleteTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.createConsumerGroup",
          "when": "view == kafkaExplorer && viewItem == kafkaGroupsFolder",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.viewConsumerGroup",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaGroup(-watched)?$/",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.resetGroupOffsets",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaGroup(-watched)?$/",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.deleteConsumerGroup",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaGroup(-watched)?$/",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.editGroupOffset",
          "when": "view == kafkaExplorer && viewItem == kafkaGroupOffset",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "1_actions@1"
        },
        {
          "command": "kafka-manager.copyBootstrapServers",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@2"
        },
        {
          "command": "kafka-manager.updateClusterName",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@3"
        },
        {
          "command": "kafka-manager.editClusterSecurity",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@4"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error",
          "group": "0_connection@1"
        },
        {
          "command": "kafka-manager.connectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-disconnected",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.connectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-disconnected",
          "group": "0_connection@1"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-(connected|connecting|error)$/",
          "group": "inline@2"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-(connected|connecting|error)$/",
          "group": "0_connection@2"
        },
        {
          "command": "kafka-manager.watchGroupLag",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaGroup(-watched)?$/",
          "group": "2_watch@1"
        },
        {
          "command": "kafka-manager.unwatchGroupLag",
          "when": "view == kafkaExplorer && viewItem == kafkaGroup-watched",
          "group": "2_watch@2"
        },
        {
          "command": "kafka-manager.configureSchemaRegistry",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@5"
        },
        {
          "command": "kafka-manager.viewAcls",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "1_actions@6"
        },
        {
          "command": "kafka-manager.viewBroker",
          "when": "view == kafkaExplorer && viewItem == kafkaBroker",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.askAi",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/ && kafka-manager.aiEnabled",
          "group": "4_ai@0"
        },
        {
          "command": "kafka-manager.showDetectedIssues",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected && kafka-manager.devMode",
          "group": "0_connection@1"
        },
        {
          "command": "kafka-manager.diagnoseWithAi",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected && kafka-manager.aiEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "kafka-manager.explainErrorWithAi",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error && kafka-manager.aiEnabled",
          "group": "inline@3"
        },
        {
          "command": "kafka-manager.explainErrorWithAi",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error && kafka-manager.aiEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "kafka-manager.explainLagWithAi",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaGroup(-watched)?$/ && kafka-manager.aiEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "kafka-manager.explainTopicWithAi",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic && kafka-manager.aiEnabled",
          "group": "4_ai@1"
        },
        {
          "command": "kafka-manager.explainBrokerWithAi",
          "when": "view == kafkaExplorer && viewItem == kafkaBroker && kafka-manager.aiEnabled",
          "group": "4_ai@1"
        }
      ],
      "commandPalette": [
        {
          "command": "kafka-manager.connectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.removeCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.deleteTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.produceMessage",
          "when": "false"
        },
        {
          "command": "kafka-manager.deleteConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.createConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.resetGroupOffsets",
          "when": "false"
        },
        {
          "command": "kafka-manager.editGroupOffset",
          "when": "false"
        },
        {
          "command": "kafka-manager.updateClusterName",
          "when": "false"
        },
        {
          "command": "kafka-manager.copyBootstrapServers",
          "when": "false"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.editClusterSecurity",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewBroker",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewAcls",
          "when": "false"
        },
        {
          "command": "kafka-manager.watchGroupLag",
          "when": "false"
        },
        {
          "command": "kafka-manager.unwatchGroupLag",
          "when": "false"
        },
        {
          "command": "kafka-manager.configureSchemaRegistry",
          "when": "false"
        },
        {
          "command": "kafka-manager.selectAiProvider",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.selectAiModel",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.setAiApiKey",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.removeAiApiKey"
        },
        {
          "command": "kafka-manager.signInOpenRouter",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.testAi",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.askAi",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.showAiModel",
          "when": "kafka-manager.aiEnabled"
        },
        {
          "command": "kafka-manager.diagnoseWithAi",
          "when": "false"
        },
        {
          "command": "kafka-manager.explainErrorWithAi",
          "when": "false"
        },
        {
          "command": "kafka-manager.explainLagWithAi",
          "when": "false"
        },
        {
          "command": "kafka-manager.analyzeLag",
          "when": "false"
        },
        {
          "command": "kafka-manager.explainTopicWithAi",
          "when": "false"
        },
        {
          "command": "kafka-manager.explainBrokerWithAi",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "kafka-manager.addCluster",
        "title": "Kafka: Add Cluster",
        "icon": "$(add)"
      },
      {
        "command": "kafka-manager.removeCluster",
        "title": "Kafka: Remove Cluster",
        "icon": "$(trash)"
      },
      {
        "command": "kafka-manager.refresh",
        "title": "Kafka: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kafka-manager.connectCluster",
        "title": "Kafka: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "kafka-manager.disconnectCluster",
        "title": "Kafka: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kafka-manager.createTopic",
        "title": "Kafka: Create Topic",
        "icon": "$(add)"
      },
      {
        "command": "kafka-manager.deleteTopic",
        "title": "Kafka: Delete Topic",
        "icon": "$(trash)"
      },
      {

{
  "name": "kafka-manager",
  "displayName": "Kafka Manager",
  "description": "Manage Apache Kafka clusters from VS Code: browse topics and partitions, inspect consumer groups and lag, and produce/tail messages.",
  "publisher": "PatrickPhan",
  "version": "0.2.0",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phankieuphu/vscode-kafka.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kafka Manager",
      "properties": {
        "kafka.clusters": {
          "type": "array",
          "default": [],
          "description": "Configured Kafka clusters. Managed via the 'Kafka: Add Cluster' command; edit by hand if you need to.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "brokers"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "brokers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ssl": {
                "description": "TLS to the brokers. `true` verifies against the system CAs; use an object for a private CA or to skip verification.",
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "caFile": {
                        "type": "string",
                        "description": "Path to a PEM file with the CA that signed the broker certificates."
                      },
                      "rejectUnauthorized": {
                        "type": "boolean",
                        "default": true,
                        "description": "Set to false to accept self-signed certificates (dev clusters only)."
                      }
                    }
                  }
                ]
              },
              "sasl": {
                "type": "object",
                "description": "SASL authentication. Passwords are kept in VS Code's secret storage, never in settings; you'll be asked for one on connect if none is saved.",
                "required": [
                  "mechanism"
                ],
                "additionalProperties": false,
                "properties": {
                  "mechanism": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "scram-sha-256",
                      "scram-sha-512",
                      "aws-iam"
                    ],
                    "enumDescriptions": [
                      "SASL/PLAIN (e.g. Confluent Cloud API keys)",
                      "SASL/SCRAM-SHA-256",
                      "SASL/SCRAM-SHA-512 (Amazon MSK)",
                      "Amazon MSK IAM, signed with your AWS credentials (TLS is always used)"
                    ]
                  },
                  "username": {
                    "type": "string",
                    "description": "For plain/scram mechanisms."
                  },
                  "region": {
                    "type": "string",
                    "description": "For aws-iam: the MSK cluster's AWS region."
                  },
                  "profile": {
                    "type": "string",
                    "description": "For aws-iam: AWS profile to use; the default credential chain when omitted."
                  }
                }
              }
            }
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kafkaExplorerContainer",
          "title": "Kafka",
          "icon": "resources/kafka.svg"
        }
      ]
    },
    "views": {
      "kafkaExplorerContainer": [
        {
          "id": "kafkaExplorer",
          "name": "Clusters"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kafka-manager.addCluster",
          "when": "view == kafkaExplorer",
          "group": "navigation@1"
        },
        {
          "command": "kafka-manager.refresh",
          "when": "view == kafkaExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "kafka-manager.openDashboard",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "inline@0"
        },
        {
          "command": "kafka-manager.openDashboard",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "0_connection@0"
        },
        {
          "command": "kafka-manager.removeCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "3_remove"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopicsFolder",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.viewTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.produceMessage",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "inline@2"
        },
        {
          "command": "kafka-manager.deleteTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaTopic",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.createConsumerGroup",
          "when": "view == kafkaExplorer && viewItem == kafkaGroupsFolder",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.viewConsumerGroup",
          "when": "view == kafkaExplorer && viewItem == kafkaGroup",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.resetGroupOffsets",
          "when": "view == kafkaExplorer && viewItem == kafkaGroup",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.deleteConsumerGroup",
          "when": "view == kafkaExplorer && viewItem == kafkaGroup",
          "group": "1_modification"
        },
        {
          "command": "kafka-manager.editGroupOffset",
          "when": "view == kafkaExplorer && viewItem == kafkaGroupOffset",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-connected",
          "group": "1_actions@1"
        },
        {
          "command": "kafka-manager.copyBootstrapServers",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@2"
        },
        {
          "command": "kafka-manager.updateClusterName",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@3"
        },
        {
          "command": "kafka-manager.editClusterSecurity",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-/",
          "group": "1_actions@4"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-error",
          "group": "0_connection@1"
        },
        {
          "command": "kafka-manager.connectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-disconnected",
          "group": "inline@1"
        },
        {
          "command": "kafka-manager.connectCluster",
          "when": "view == kafkaExplorer && viewItem == kafkaCluster-disconnected",
          "group": "0_connection@1"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-(connected|connecting|error)$/",
          "group": "inline@2"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "view == kafkaExplorer && viewItem =~ /^kafkaCluster-(connected|connecting|error)$/",
          "group": "0_connection@2"
        }
      ],
      "commandPalette": [
        {
          "command": "kafka-manager.connectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.disconnectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.removeCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.createTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.deleteTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewTopic",
          "when": "false"
        },
        {
          "command": "kafka-manager.produceMessage",
          "when": "false"
        },
        {
          "command": "kafka-manager.deleteConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.createConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.viewConsumerGroup",
          "when": "false"
        },
        {
          "command": "kafka-manager.resetGroupOffsets",
          "when": "false"
        },
        {
          "command": "kafka-manager.editGroupOffset",
          "when": "false"
        },
        {
          "command": "kafka-manager.updateClusterName",
          "when": "false"
        },
        {
          "command": "kafka-manager.copyBootstrapServers",
          "when": "false"
        },
        {
          "command": "kafka-manager.reconnectCluster",
          "when": "false"
        },
        {
          "command": "kafka-manager.editClusterSecurity",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "kafka-manager.addCluster",
        "title": "Kafka: Add Cluster",
        "icon": "$(add)"
      },
      {
        "command": "kafka-manager.removeCluster",
        "title": "Kafka: Remove Cluster",
        "icon": "$(trash)"
      },
      {
        "command": "kafka-manager.refresh",
        "title": "Kafka: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kafka-manager.connectCluster",
        "title": "Kafka: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "kafka-manager.disconnectCluster",
        "title": "Kafka: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kafka-manager.createTopic",
        "title": "Kafka: Create Topic",
        "icon": "$(add)"
      },
      {
        "command": "kafka-manager.deleteTopic",
        "title": "Kafka: Delete Topic",
        "icon": "$(trash)"
      },
      {
        "command": "kafka-manager.viewTopic",
        "title": "Kafka: Browse Messages",
        "icon": "$(eye)"
      },
      {
        "command": "kafka-manager.produceMessage",
        "title": "Kafka: Produce Message",
        "icon": "$(arrow-up)"
      },
      {
        "command": "kafka-manager.deleteConsumerGroup",
        "title": "Kafka: Delete Consumer Group",
        "icon": "$(trash)"
      },
      {
        "command": "kafka-manager.createConsumerGroup",
        "title": "Kafka: Create Consumer Group",
        "icon": "$(add)"
      },
      {
        "command": "kafka-manager.viewConsumerGroup",
        "title": "Kafka: View Group Details",
        "icon": "$(eye)"
      },
      {
        "command": "kafka-manager.resetGroupOffsets",
        "title": "Kafka: Reset Group Offsets..."
      },
      {
        "command": "kafka-manager.editGroupOffset",
        "title": "Kafka: Edit Offset...",
        "icon": "$(edit)"
      },
      {
        "command": "kafka-manager.openDashboard",
        "title": "Kafka: Open Cluster Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "kafka-manager.showOutput",
        "title": "Kafka: Show Output Channel"
      },
      {
        "command": "kafka-manager.updateClusterName",
        "title": "Kafka: Rename Cluster…"
      },
      {
        "command": "kafka-manager.copyBootstrapServers",
        "title": "Kafka: Copy Bootstrap Servers",
        "icon": "$(copy)"
      },
      {
        "command": "kafka-manager.reconnectCluster",
        "title": "Kafka: Reconnect",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kafka-manager.editClusterSecurity",
        "title": "Kafka: Edit Connection Security…",
        "icon": "$(lock)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "kafkaExplorer",
        "contents": "No Kafka clusters yet. Add a cluster by entering its bootstrap servers, e.g. `localhost:9092`.\n[Add Cluster](command:kafka-manager.addCluster)\nSupports plaintext, TLS, SASL/PLAIN, SASL/SCRAM and Amazon MSK IAM. Clusters are stored in the [kafka.clusters](command:workbench.action.openSettings?%5B%22kafka.clusters%22%5D) setting; passwords go to VS Code's secret storage."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "24.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.13.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "aws-msk-iam-sasl-signer-js": "^1.0.3",
    "kafkajs": "^2.2.4"
  }
}

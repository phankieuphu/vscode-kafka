    "viewsWelcome": [
      {
        "view": "kafkaExplorer",
        "contents": "No Kafka clusters yet. Add a cluster by entering its bootstrap servers, e.g. `localhost:9092`.\n[Add Cluster](command:kafka-manager.addCluster)\nSupports plaintext, TLS (including client certificates), SASL/PLAIN, SASL/SCRAM and Amazon MSK IAM. Clusters are stored in the [kafka.clusters](command:workbench.action.openSettings?%5B%22kafka.clusters%22%5D) setting, in user or workspace settings; passwords go to VS Code's secret storage."
      },
      {
        "view": "kafkaExplorer",
        "contents": "Kafka AI explains health, lag, configs and connection errors with Claude, GPT, Gemini, a local Ollama model or GitHub Copilot.\n[Set Up AI](command:kafka-manager.aiSetup)",
        "when": "kafka-manager.aiEnabled"
      }
    ],
    "chatParticipants": [
      {
        "id": "kafka-manager.kafka",
        "name": "kafka",
        "fullName": "Kafka",
        "isSticky": true,
        "description": "Ask about your Kafka clusters: health, lag, topics and connection errors. Uses your Kafka AI provider (Claude, GPT, Gemini…) or the chat's model.",
        "commands": [
          {
            "name": "diagnose",
            "description": "Health check a cluster: partitions, brokers, groups and lag"
          },
          {
            "name": "lag",
            "description": "Explain a consumer group's lag, e.g. /lag orders-consumer"
          },
          {
            "name": "explain-error",
            "description": "Explain why a cluster failed to connect"
          },
          {
            "name": "topic",
            "description": "Explain a topic's layout and risky configs, e.g. /topic orders"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "kafka_listClusters",
        "displayName": "List Kafka Clusters",
        "toolReferenceName": "kafka_listClusters",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "List the Kafka clusters configured in Kafka Manager and whether they are connected.",
        "modelDescription": "Lists the Apache Kafka clusters configured in Kafka Manager with their connection status and security mode. Call this first to learn cluster names. Other kafka_* tools only work on connected clusters.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "kafka_clusterOverview",
        "displayName": "Kafka Cluster Overview",
        "toolReferenceName": "kafka_clusterOverview",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "Health of a Kafka cluster: brokers, controller, partition problems and consumer lag.",
        "modelDescription": "Returns a connected Kafka cluster's health: brokers and controller, under-replicated and offline partitions, topics, and consumer groups sorted by lag. Use for health checks and to find lagging groups.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            }
          }
        }
      },
      {
        "name": "kafka_listTopics",
        "displayName": "List Kafka Topics",
        "toolReferenceName": "kafka_listTopics",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "List the topics of a Kafka cluster.",
        "modelDescription": "Lists the topics of a connected Kafka cluster with partition counts. Optionally filter by a substring of the name.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            },
            "filter": {
              "type": "string",
              "description": "Only topics whose name contains this text (case-insensitive)."
            }
          }
        }
      },
      {
        "name": "kafka_describeTopic",
        "displayName": "Describe Kafka Topic",
        "toolReferenceName": "kafka_describeTopic",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "Partitions, replicas, ISR, message counts and configuration of a topic, with risky settings flagged.",
        "modelDescription": "Describes one topic of a connected Kafka cluster: partitions with leader, replicas, ISR and message counts; non-default configuration; and Kafka Manager's rule-based risk findings (replication, min.insync.replicas, retention, compaction, leader skew).",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            },
            "topic": {
              "type": "string",
              "description": "Topic name."
            }
          },
          "required": [
            "topic"
          ]
        }
      },
      {
        "name": "kafka_listConsumerGroups",
        "displayName": "List Kafka Consumer Groups",
        "toolReferenceName": "kafka_listConsumerGroups",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "List the consumer groups of a Kafka cluster.",
        "modelDescription": "Lists the consumer group ids of a connected Kafka cluster. Use kafka_clusterOverview for their lag, or kafka_describeConsumerGroup for one group.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            }
          }
        }
      },
      {
        "name": "kafka_describeConsumerGroup",
        "displayName": "Describe Kafka Consumer Group",
        "toolReferenceName": "kafka_describeConsumerGroup",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "State, members, partition assignment and lag per partition of a consumer group.",
        "modelDescription": "Describes one consumer group of a connected Kafka cluster: state, members and which partitions each owns, and committed offset, end offset and lag per partition (most lag first). Use to explain lag.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            },
            "group": {
              "type": "string",
              "description": "Consumer group id."
            }
          },
          "required": [
            "group"
          ]
        }
      },
      {
        "name": "kafka_describeBroker",
        "displayName": "Describe Kafka Broker",
        "toolReferenceName": "kafka_describeBroker",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "A broker's role, rack, partition load and non-default settings, with risky settings flagged.",
        "modelDescription": "Describes one broker of a connected Kafka cluster: address, controller role, rack, leader and replica counts, non-default settings, and Kafka Manager's rule-based findings. Get broker ids from kafka_clusterOverview.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            },
            "brokerId": {
              "type": "integer",
              "description": "Broker node id."
            }
          },
          "required": [
            "brokerId"
          ]
        }
      },
      {
        "name": "kafka_listAcls",
        "displayName": "List Kafka ACLs",
        "toolReferenceName": "kafka_listAcls",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "The ACLs of a Kafka cluster.",
        "modelDescription": "Lists the ACLs of a connected Kafka cluster (resource, pattern, principal, host, operation, permission). Use for authorization errors.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            }
          }
        }
      },
      {
        "name": "kafka_connectionError",
        "displayName": "Kafka Connection Error",
        "toolReferenceName": "kafka_connectionError",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "Why a Kafka cluster failed to connect: the error chain and Kafka Manager's hint.",
        "modelDescription": "Returns the last connection error of a Kafka cluster (connected or not): the full cause chain, the security mode (TLS/SASL mechanism, never credentials) and Kafka Manager's rule-based hint. Use when a cluster is in the error state.",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager."
            }
          },
          "required": [
            "cluster"
          ]
        }
      },
      {
        "name": "kafka_peekMessages",
        "displayName": "Peek Kafka Messages",
        "toolReferenceName": "kafka_peekMessages",
        "canBeReferencedInPrompt": true,
        "icon": "$(database)",
        "userDescription": "Read the newest few messages of a topic (only with kafka.ai.includeMessagePayloads on).",
        "modelDescription": "Reads up to 10 of the newest messages of a topic on a connected Kafka cluster, with keys, headers and truncated values. Only works when the user allowed message contents (kafka.ai.includeMessagePayloads).",
        "tags": [
          "kafka",
          "read-only"
        ],
        "when": "kafka-manager.aiEnabled",
        "inputSchema": {
          "type": "object",
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Cluster name as shown in Kafka Manager. Optional when only one cluster is connected."
            },
            "topic": {
              "type": "string",
              "description": "Topic name."
            },
            "count": {
              "type": "integer",
              "description": "How many messages, 1-10 (default 5)."
            },
            "partition": {
              "type": "integer",
              "description": "Only this partition."
            }
          },
          "required": [
            "topic"
          ]
        }
      }
    ]
